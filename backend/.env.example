# Copy this file to .env and fill in your real values

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=preschool_db

# JWT auth
SECRET_KEY=change_this_to_a_long_random_secret_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploaded files (profile photos, homework files, activity photos,
# event photos, the fee QR code and Child Mode videos)
UPLOAD_DIR=
MAX_UPLOAD_MB=80

# AI Learning Buddy — set ONE of these. Without a key the buddy still works
# using built-in preschool replies. Check /api/child/ai-buddy/status to see
# which provider is live.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
